@model UpdateBannerDto

@{
    ViewData["Title"] = "UpdateBanner";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}





<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-xl-12">


                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Yeni Banner Girişi</h4>
                        <p class="card-subtitle mb-4"> Banner alanına veri girişini aşağıdaki panelden yapabilirsiniz. Tasarımda bozulma olmaması adına yeni banner girişi yaptıktan sonra önceki banner alanını silin, sadece bir tane banner verisi kalmalıdır.</p>

                        <form method="post">
                            <input type="hidden" asp-for="BannerID"/>
                            <div class="form-group">
                                <label for="exampleInputTitle"> Başlık</label>
                                <input type="text" class="form-control" id="exampleInputName" asp-for="Title" placeholder="Başlığı Giriniz">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputDescription"> Açıklama</label>
                                <input type="text" class="form-control" id="exampleInputName" asp-for="Description" placeholder="Açıklamayı Giriniz">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputVideoDescription"> Video Açıklama</label>
                                <input type="text" class="form-control" id="exampleInputName" asp-for="VideoDescription" placeholder="Video Açıklama Bilgisini Giriniz ">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputVideoUrl"> Video URL</label>
                                <input type="text" class="form-control" id="exampleInputName" asp-for="VideoUrl" placeholder="Videonun Youtube Embed Linkini Giriniz">
                            </div>


                            <button type="submit" class="btn btn-success waves-effect waves-light">Banner Bilgisini Güncelle</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>







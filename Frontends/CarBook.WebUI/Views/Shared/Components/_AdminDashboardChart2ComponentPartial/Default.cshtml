
@model List<ResultBrandCarCountDto>

<script src="~/chart.js"></script>

<div class="col-lg-4">
    <div class="card">
        <div class="card-body">

            <h4 class="card-title d-inline-block">
                Araç Marka Sayıları
            </h4>

            <canvas id="my2Chart" height="120"></canvas>

            <script>

                function getRandomColor() {

                    var letters = '0123456789ABCDEF';
                    var color = '#';

                    for (var i = 0; i < 6; i++) {
                        color += letters[Math.floor(Math.random() * 16)];
                    }

                    return color;
                }

                var values = document
                    .getElementById('my2Chart')
                    .getContext('2d');

                var chart = new Chart(values, {

                    type: 'pie',

                    data: {

                        labels: [
                @foreach (var item in Model)
                {
                    @: '@item.BrandName',
                }
                                        ],

                        datasets: [{

                            label: 'Araç Marka Sayıları',

                            data: [
                @foreach (var item in Model)
                {
                    @: @item.CarCount,
                }
                                            ],

                            backgroundColor: [
                @foreach (var item in Model)
                {
                    @:getRandomColor(),
                }
                                            ],

                            borderWidth: 1

                        }]
                    }

                });

            </script>

        </div>
    </div>
</div>